# Anthropic API key used to draft replies. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Flask session signing key. Any random string for local development.
SECRET_KEY=change-me

# Path to the Google OAuth client secrets JSON.
# Optional; defaults to credentials/credentials.json
# GOOGLE_CLIENT_SECRETS=credentials/credentials.json

# Where the Vite dev server is running. OAuth returns the user here.
# Optional; defaults to http://localhost:5174
# CLIENT_URL=http://localhost:5174
